{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atmos-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "atmos-notifications",
      },
    ],
  },
}
