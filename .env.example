# Public browser configuration. These values are safe to expose, but authorization
# must never rely on their secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Local-only OpenCode/OpenRouter configuration. Keep the real value in .env only.
OPENROUTER_API_KEY=

# Server-only values. Never expose these with NEXT_PUBLIC_ prefixes.
SUPABASE_SECRET_KEY=
CLOUDFLARE_API_TOKEN=
VERCEL_TOKEN=
