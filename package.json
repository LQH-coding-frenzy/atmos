{
  "name": "atmos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @atmos/web dev",
    "dev:web": "corepack pnpm --filter @atmos/web dev",
    "dev:gateway": "corepack pnpm --filter @atmos/gateway dev",
    "build": "corepack pnpm --filter @atmos/contracts build && corepack pnpm --filter @atmos/domain build && corepack pnpm --filter @atmos/provider-openmeteo build && corepack pnpm --filter @atmos/web build && corepack pnpm --filter @atmos/gateway build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "security:local": "gitleaks git --no-banner && trivy fs --scanners vuln,secret,misconfig --exit-code 1 .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "globals": "16.5.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
